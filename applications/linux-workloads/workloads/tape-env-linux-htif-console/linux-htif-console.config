# Route Linux console output through the legacy SBI console interface. The
# paired P2E DTB selects OpenSBI's ucb,htif0 backend, so these bytes reach
# FESVR through tohost/fromhost instead of the unconnected physical UART.
CONFIG_RISCV_SBI_V01=y
CONFIG_HVC_RISCV_SBI=y
CONFIG_SERIAL_EARLYCON_RISCV_SBI=y
CONFIG_CMDLINE="console=hvc0 earlycon=sbi"
CONFIG_CMDLINE_FORCE=y
