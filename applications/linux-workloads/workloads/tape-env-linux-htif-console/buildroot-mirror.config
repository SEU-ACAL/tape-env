# Keep the HTIF-console workload's Buildroot settings identical to the normal
# P2E Linux workload. The only behavioral difference is its Linux console.
BR2_PRIMARY_SITE="https://mirror.nju.edu.cn/buildroot"
BR2_TOOLCHAIN_EXTERNAL_HEADERS_6_8=y
BR2_TOOLCHAIN_HEADERS_AT_LEAST_6_8=y
BR2_TOOLCHAIN_HEADERS_AT_LEAST="6.8"
BR2_ROOTFS_POST_BUILD_SCRIPT="../../scripts/fix-linux-nix-elfs.sh"
BR2_ROOTFS_MERGED_USR=y
# BR2_TOOLCHAIN_EXTERNAL_FORTRAN is not set
