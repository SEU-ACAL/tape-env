# Buildroot's source mirror preserves per-package subdirectories, including
# upstream GitHub releases such as libxcrypt.
BR2_PRIMARY_SITE="https://mirror.nju.edu.cn/buildroot"

# FireMarshal's Buildroot 2024.05 knows kernel-header versions through 6.8.
# Nixpkgs supplies 6.18 headers; select the documented latest-known choice,
# which accepts newer headers for custom external toolchains.
BR2_TOOLCHAIN_EXTERNAL_HEADERS_6_8=y
BR2_TOOLCHAIN_HEADERS_AT_LEAST_6_8=y
BR2_TOOLCHAIN_HEADERS_AT_LEAST="6.8"

# The Nix cross toolchain is used only to build this image. Remove its host
# store RPATHs from target ELF files before Buildroot packages the rootfs.
BR2_ROOTFS_POST_BUILD_SCRIPT="../../../../../../scripts/fix-firemarshal-nix-elfs.sh"

# The Tapeout Nix cross toolchain has C/C++ but no cross gfortran.  Buildroot
# does not need Fortran to build this minimal Linux workload.
# BR2_TOOLCHAIN_EXTERNAL_FORTRAN is not set
