[remote]
# Use user@host directly; an SSH config alias is not required.
host = "<user>@<server-address>"
# Set this when the SSH server does not use port 22.
port = 52123
# Must be an absolute directory writable by the remote SSH user.
remote_root = "/home/<user>/p2e"

[p2e]
rtl_dir = "dependencies/p2e-runner/platform/tape-env/generated-src/chipyard.p2e.hpec.P2ETop.HpecP2ETapeoutConfig/gen-collateral"
# Load ELF PT_LOAD segments through the HPEC DDR backdoor before HTIF starts.
preload_ddr = true
